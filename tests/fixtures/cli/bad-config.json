{
  "model": {
    "dim": 16,
    "context_length": 16,
    "n_layers": 1,
    "block": {
      "n_heads": 4,
      "n_kv_heads": 3,
      "mlp": "swiglu",
      "mlp_hidden": 40,
      "norm": "rmsnorm",
      "position": "rope"
    }
  },
  "train": {
    "batch": 2,
    "seq": 16,
    "steps": 20,
    "lr": 1e-3,
    "min_lr": 1e-4,
    "warmup": 5,
    "eval_interval": 10,
    "eval_batches": 2,
    "log_interval": 5,
    "seed": 1
  }
}
