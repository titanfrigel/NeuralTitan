root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,hpp,cu,cuh,h,in,ps1}]
indent_size = 4

# The existing CMake code uses 2-space indentation.
[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
