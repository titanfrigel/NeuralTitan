{
  "model": {
    "dim": 128,
    "context_length": 128,
    "n_layers": 4,
    "block": {
      "n_heads": 4,
      "n_kv_heads": 2,
      "mlp": "swiglu",
      "mlp_hidden": 344,
      "norm": "rmsnorm",
      "position": "rope"
    },
    "rope_theta": 10000,
    "norm_eps": 1e-5,
    "tied_embeddings": true
  },
  "train": {
    "batch": 16,
    "seq": 128,
    "steps": 2000,
    "grad_accum": 1,
    "lr": 1e-3,
    "min_lr": 1e-4,
    "warmup": 100,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-8,
    "grad_clip": 1.0,
    "eval_interval": 200,
    "eval_batches": 20,
    "log_interval": 50,
    "seed": 1337,
    "val_fraction": 0.1
  }
}
