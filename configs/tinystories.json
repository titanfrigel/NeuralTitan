{
  "model": {
    "dim": 512,
    "context_length": 512,
    "n_layers": 8,
    "block": {
      "n_heads": 8,
      "n_kv_heads": 4,
      "mlp": "swiglu",
      "mlp_hidden": 1376,
      "norm": "rmsnorm",
      "position": "rope"
    },
    "rope_theta": 10000,
    "norm_eps": 1e-5,
    "tied_embeddings": true
  },
  "train": {
    "batch": 8,
    "seq": 512,
    "grad_accum": 4,
    "steps": 24000,
    "lr": 1e-3,
    "min_lr": 1e-4,
    "warmup": 1000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-8,
    "grad_clip": 1.0,
    "eval_interval": 1000,
    "eval_batches": 200,
    "log_interval": 100,
    "checkpoint_interval": 1000,
    "seed": 1337
  }
}
