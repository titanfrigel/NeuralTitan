#!/bin/sh
# Scans the staged changes for secrets with gitleaks before every commit.
# Enable once per clone with: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not on PATH; install it (winget install Gitleaks.Gitleaks) and retry." >&2
    exit 1
fi

exec gitleaks git --pre-commit --redact --staged --verbose
